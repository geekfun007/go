# MySQL 配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=user_db

# Kitex RPC 服务配置
RPC_HOST=0.0.0.0
RPC_PORT=8888
RPC_SERVICE_NAME=user_service

# Hertz HTTP 服务配置
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Etcd 配置
ETCD_ENDPOINTS=localhost:2379

# 服务注册与发现
REGISTRY_ENABLE=true
